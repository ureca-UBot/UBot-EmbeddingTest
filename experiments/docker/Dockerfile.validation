FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8
WORKDIR /workspace
COPY docker/requirements-validation.txt /tmp/requirements-validation.txt
RUN pip install --no-cache-dir -r /tmp/requirements-validation.txt
CMD ["python", "model_benchmarks/scripts/validate_retrieval_dataset.py", "--allow-design-examples", "--source-map", "model_benchmarks/configs/container_source_paths.json"]
